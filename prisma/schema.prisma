generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================================
// PERFIL E AUTH (login/senha próprios — ver lib/auth/)
// ===================================

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String   @unique
  name      String
  avatarUrl String?
  phone     String?
  role      Role     @default(VENDEDOR)
  segment   String?
  onboarded Boolean  @default(false)

  // Login próprio — nullable pq contas migradas do Clerk nascem sem senha (ver
  // lib/auth/password.ts); usuário é direcionado a "esqueci minha senha" nesse caso.
  passwordHash    String?
  emailVerifiedAt DateTime?

  emailVerifyToken      String?   @unique
  emailVerifyExpiresAt  DateTime?
  passwordResetToken    String?   @unique
  passwordResetExpiresAt DateTime?

  // Assinatura Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  plan                 Plan    @default(FREE)
  planExpiresAt        DateTime?

  // Produtos contratados individualmente — só usado quando o profile NÃO pertence a
  // nenhum Team (vendedor/funcionário avulso); quem tem Team herda de Team.productsOwned
  productsOwned SoldProduct[] @default([PLATAFORMA])

  // Gamificação
  xp    Int @default(0)
  level Int @default(1)

  // Relações
  diagnostics       Diagnostic[]
  virtualCompany    VirtualCompany?
  progress          UserProgress[]
  lessonProgress    UserLessonProgress[]
  objectionSessions ObjectionSession[]
  generatedScripts  GeneratedScript[]
  xpTransactions    XPTransaction[]
  userBadges        UserBadge[]
  userMissions      UserMission[]
  ninetyDayPlans    NinetyDayPlan[]
  managedTeam       Team?           @relation("TeamManager")
  teamMembership    TeamMember?
  sentMessages      Message[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  scheduledMessages ScheduledMessage[]
  opportunityTasks OpportunityTask[]
  treinoExemplosCriados TreinoExemplo[]
  opportunityFiles OpportunityFile[]
  demoBookings DemoBooking[]
}

// Cadastro "em espera" enquanto o código de verificação do WhatsApp não é
// confirmado — o Profile só é criado de verdade em /api/auth/cadastro/verificar.
// Evita conta com número de WhatsApp falso/de terceiro na base.
model PendingSignup {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  name          String
  email         String   @unique
  passwordHash  String
  phone         String

  code          String
  codeExpiresAt DateTime
  attempts      Int      @default(0)
}

enum Role {
  VENDEDOR
  FUNCIONARIO
  GESTOR
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

// CRM (agente de WhatsApp/atendimento) e Plataforma (treinamento) podem ser vendidos
// separadamente — ver lib/products.ts e o gate de acesso em app/(app)/ProductGate.tsx
// (nome "SoldProduct" pra não colidir com o model Product do catálogo de comércio)
enum SoldProduct {
  CRM
  PLATAFORMA
}

// ===================================
// MÓDULO 1 — SCANNER EMPRESARIAL
// ===================================

model Diagnostic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  // Dados da empresa
  companyName String
  segment     String
  teamSize    String

  // Scores por categoria (0-100)
  scoreLeads     Int @default(0)
  scoreProcess   Int @default(0)
  scoreTeam      Int @default(0)
  scoreKpis      Int @default(0)
  scoreTools     Int @default(0)
  scoreValue     Int @default(0)
  scoreRetention Int @default(0)
  scoreMoney     Int @default(0)
  scoreTotal     Int @default(0)

  answers        String // JSON das respostas
  diagnosticType String @default("EMPRESA") // EMPRESA | VENDEDOR
  llm            String @default("claude")

  result DiagnosticResult?
}

model DiagnosticResult {
  id           String     @id @default(cuid())
  diagnosticId String     @unique
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  summary        String
  strengths      String // JSON array
  weaknesses     String // JSON array
  actions        String // JSON array
  priority       String // CRITICO | ATENCAO | BOM | EXCELENTE
  classification String @default("{}") // JSON: { leads: CRITICO|ATENCAO|FORTE, ... }
  insights       String @default("{}") // JSON: { leads: "...", ... }
}

// ===================================
// MÓDULO 2 — SIMULAÇÃO GAMIFICADA
// ===================================

model VirtualCompany {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId    String  @unique
  profile      Profile @relation(fields: [profileId], references: [id])
  diagnosticId String?

  name         String
  segment      String
  currentMRR   Float  @default(0)
  currentMonth Int    @default(1)

  rounds SimulationRound[]
}

model SimulationRound {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  companyId String
  company   VirtualCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  month     Int
  mrrBefore Float
  mrrAfter  Float

  decisions   RoundDecision[]
  aiAnalysis  String? // JSON — benchmark + feedback da IA

  unlockedTrailId String?
}

model RoundDecision {
  id      String          @id @default(cuid())
  roundId String
  round   SimulationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  category String
  decision String
  impact   Float // impacto percentual no MRR
  xpGained Int   @default(0)
}

// ===================================
// MÓDULO 3 — TRILHAS DE APRENDIZADO
// ===================================

model Trail {
  id          String   @id @default(cuid())
  title       String
  description String
  segments    String[] // segmentos de mercado aplicáveis
  funnel      FunnelStage
  coverImage  String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  modules  TrailModule[]
  progress UserProgress[]
}

enum FunnelStage {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHAMENTO
  POS_VENDA
}

model TrailModule {
  id          String @id @default(cuid())
  trailId     String
  trail       Trail  @relation(fields: [trailId], references: [id], onDelete: Cascade)

  title       String
  description String
  order       Int    @default(0)

  lessons Lesson[]
}

model Lesson {
  id       String      @id @default(cuid())
  moduleId String
  module   TrailModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title     String
  type      LessonType @default(TEXT)
  content   String // Markdown ou URL de vídeo
  order     Int        @default(0)
  xpReward  Int        @default(10)
  duration  Int        @default(5) // minutos estimados

  quiz     Quiz?
  progress UserLessonProgress[]
}

enum LessonType {
  TEXT
  VIDEO
  QUIZ
}

model Quiz {
  id       String @id @default(cuid())
  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
}

model QuizQuestion {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  question String
  options  String[] // array de alternativas
  correct  Int      // índice da opção correta
  order    Int      @default(0)
}

model UserProgress {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  trailId   String
  trail     Trail    @relation(fields: [trailId], references: [id])

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  completed   Boolean   @default(false)

  @@unique([profileId, trailId])
}

model UserLessonProgress {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  completed   Boolean   @default(false)
  score       Int? // pontuação no quiz (0-100)
  completedAt DateTime?

  @@unique([profileId, lessonId])
}

// ===================================
// MÓDULO 4 — SIMULADOR DE OBJEÇÕES
// ===================================

model ObjectionSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  objection String // tipo de objeção (preço, concorrente, timing...)
  segment   String
  product   String

  messages   ObjectionMessage[]
  completed  Boolean @default(false)
  finalScore Int? // 0-100
  feedback   String? // feedback da IA ao final
  xpGained   Int     @default(0)
}

model ObjectionMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   ObjectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      String // "user" | "assistant" (IA como cliente)
  content   String
  createdAt DateTime @default(now())
}

// ===================================
// MÓDULO 5 — GERADOR DE SCRIPTS
// ===================================

model GeneratedScript {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  segment      String
  leadRole     String // cargo do lead
  product      String
  painPoint    String

  coldCall      String // roteiro de cold call
  followUpEmail String // e-mail de follow-up
  proposal      String // estrutura de proposta
  linkedinMsg   String // mensagem LinkedIn

  llm String @default("claude")
}

// ===================================
// MÓDULO 6 — PLAYBOOK INTERATIVO
// ===================================

model PlaybookItem {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  title     String
  content   String   // Markdown
  category  FunnelStage
  segments  String[] // segmentos aplicáveis
  tags      String[]
  order     Int      @default(0)
  published Boolean  @default(true)
}

// ===================================
// MÓDULO 7 — GAMIFICAÇÃO
// ===================================

model XPTransaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])

  amount Int
  reason String
  source XPSource
}

enum XPSource {
  LESSON_COMPLETE
  QUIZ_PASS
  OBJECTION_PRACTICE
  SCRIPT_GENERATE
  SIMULATION_ROUND
  MISSION_COMPLETE
  BADGE_UNLOCK
  DAILY_LOGIN
  SCANNER_COMPLETE
  DEAL_WON
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String // emoji ou URL
  condition   String // JSON — condição para desbloquear
  xpBonus     Int    @default(0)
  rarity      String @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([profileId, badgeId])
}

model Mission {
  id          String      @id @default(cuid())
  title       String
  description String
  xpReward    Int
  type        MissionType @default(WEEKLY)
  condition   String // JSON — { action, count }
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  userMissions UserMission[]
}

enum MissionType {
  DAILY
  WEEKLY
  PERMANENT
}

model UserMission {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])

  progress     Int      @default(0)
  completed    Boolean  @default(false)
  completedAt  DateTime?
  weekStart    DateTime? // para missões semanais
  solutionText String?  // plano gerado pela IA ao concluir o desafio

  @@unique([profileId, missionId, weekStart])
}

model NinetyDayPlan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  diagnosticId String @unique
  content      String // narrativa do plano de 90 dias gerado pela IA

  actions PlanAction[]
}

model PlanAction {
  id     String        @id @default(cuid())
  planId String
  plan   NinetyDayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  area        String // leads | process | team | kpis | tools | value | retention | money
  phase       Int       @default(1) // 1 = dias 1-30, 2 = dias 31-60, 3 = dias 61-90
  text        String
  impact      Int       @default(5) // quanto soma no score da área ao ser concluída
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
}

// ===================================
// MÓDULO 8 — PAINEL DO GESTOR
// ===================================

model Team {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  managerId String  @unique
  manager   Profile @relation("TeamManager", fields: [managerId], references: [id])

  name          String
  businessModel String  @default("B2B")  // B2B | B2C
  segment       String  @default("")
  subsegment    String  @default("")
  size          String  @default("1-10")
  invite        String  @unique @default(cuid()) // código de convite

  monthlyTokenLimit Int?

  // Produtos contratados por essa equipe — default com os dois pra não quebrar equipes
  // já existentes; novas equipes escolhem no onboarding (ver app/api/onboarding/route.ts)
  productsOwned SoldProduct[] @default([CRM, PLATAFORMA])

  // Teste grátis do CRM — setado automaticamente pelo onboarding quando o cadastro inclui
  // CRM; passada a data, getEffectiveProducts() para de considerar CRM como contratado
  // mesmo que ainda conste em productsOwned (ver lib/products.ts). null = sem trial ativo.
  crmTrialEndsAt DateTime?

  // Créditos de IA comprados pela equipe — não expiram; são consumidos automaticamente
  // depois que o uso do mês estoura o monthlyTokenLimit (ver lib/token-usage.ts)
  aiCreditsBalance Int     @default(0)
  // Cliente na conta Asaas DA PRÓPRIA PLATAFORMA (ASAAS_PLATFORM_API_KEY) — não confundir
  // com o Asaas de cada agente (AgentConfig.asaasApiKey), que é a conta do cliente pra vender
  asaasCustomerId  String?

  members           TeamMember[]
  departamentos     Departamento[]
  crmAccessProfiles CrmAccessProfile[]
  goals             Goal[]
  announcements     Announcement[]
  agentConfigs      AgentConfig[]
  creditoCompras    CreditoCompra[]
  tokenUsageLogs    TokenUsageLog[]
  demoBookings      DemoBooking[]
  planPurchases     PlanPurchase[]
  trialFunnelSent   TrialFunnelSent[]

  // Plano do CRM comprado via aba Recursos > Ver planos (lib/crm-plans.ts) — null = ainda
  // não comprou nenhum (trial/sem plano definido). Cobrança avulsa, sem renovação automática.
  crmPlanTier String?
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id])
  joinedAt  DateTime @default(now())

  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  accessProfileId String?
  accessProfile   CrmAccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)

  // Inativo = mantém no time (histórico, departamento, perfil) mas perde o login —
  // diferente de excluir, que apaga o vínculo com a equipe de vez.
  active Boolean @default(true)

  // Co-gestor: mesmo nível de acesso do dono da equipe (Team.managerId) dentro do CRM —
  // vê e administra tudo, não só o que foi atribuído a ele. Ver lib/team.ts#listMyAgentConfigs.
  coManager Boolean @default(false)

  @@unique([teamId, profileId])
}

// Departamento da equipe (Vendas, Suporte, Financeiro...) — a IA transfere conversas
// para o departamento certo com base na descrição do que cada um atende
model Departamento {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  nome      String
  descricao String @default("") // o que esse departamento atende — a IA usa pra rotear

  membros       TeamMember[]
  conversations Conversation[]

  @@index([teamId])
}

// Perfil de acesso configurável do CRM — restringe quais páginas do CRM um membro do
// time enxerga/acessa. Sem perfil atribuído (TeamMember.accessProfileId null), o membro
// mantém acesso total (comportamento padrão) — só fica restrito quando um perfil é atribuído.
model CrmAccessProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  nome         String
  allowedPages String[] @default([]) // chaves de lib/crm-nav-config.ts (CrmPageKey[])

  // false = só vê conversas já atribuídas a si mesmo — não enxerga leads novos ainda sem
  // atendente. Default true preserva o comportamento de sempre (todo mundo via não atribuídos).
  verNaoAtribuidos Boolean @default(true)

  membros TeamMember[]

  @@index([teamId])
}

model Goal {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  title     String
  target    Float
  current   Float    @default(0)
  unit      String // "leads", "conversões", "%", etc.
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  title     String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ===================================
// MÓDULO 9 — FERRAMENTAS PLUG-AND-PLAY
// AGENTE DE ATENDIMENTO IA NO WHATSAPP
// ===================================

model AgentConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sem @unique: uma equipe pode ter vários agentes (cada um seu número de WhatsApp e CRM)
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  nome     String   @default("Assistente")
  tom      String   @default("CONSULTIVO") // FORMAL | PROXIMO | CONSULTIVO
  servicos String[] @default([])
  objecoes String[] @default([])
  horario  String   @default("")

  // Setor desse agente (taxonomia de lib/segments.ts) — usado pra personalizar o system prompt
  segmento    String @default("")
  subsegmento String @default("")

  descricaoEmpresa String @default("") // história, diferenciais, público-alvo
  precos           String @default("") // valores, formas de pagamento, parcelamento, garantias
  enderecoContato  String @default("") // endereço, site, redes sociais, outros canais

  systemPrompt String?
  active       Boolean @default(false)

  // Pausa só a resposta automática da IA nesse canal — mensagens continuam chegando e sendo
  // salvas normalmente, só não geram resposta automática (diferente de "active", que
  // desliga o canal inteiro). Independentes: um time pode ter WhatsApp e Instagram na mesma
  // AgentConfig e pausar só um dos dois.
  whatsappAiPaused  Boolean @default(false)
  instagramAiPaused Boolean @default(false)

  // Estado inicial de todo agente novo: mensagens são salvas normalmente mas a IA não
  // responde em nenhum canal, até o gestor clicar em "Ativar IA" (vê/valida antes de ir ao ar).
  learningMode Boolean @default(false)

  uazapiInstance String?
  uazapiToken    String?

  // WhatsApp Cloud API (Meta oficial) — alternativa exclusiva à UazAPI, escolhida via whatsappProvider
  whatsappProvider      WhatsappProvider @default(UAZAPI)
  cloudApiPhoneNumberId String?
  cloudApiWabaId        String?
  cloudApiAccessToken   String?
  cloudApiVerifyToken   String? // gerado ao salvar; comparado no handshake GET do webhook da Meta
  cloudApiPhoneNumber   String? // display_phone_number confirmado via "testar conexão"
  cloudApiVerifiedName  String?

  followupEnabled       Boolean @default(true)
  followupDelaysMinutes Json    @default("[1440]") // minutos de espera por tentativa, ex: [1440, 720] = 24h, depois +12h. O número de tentativas é o tamanho do array.

  schedulingEnabled        Boolean @default(false)
  slotDurationMinutes      Int     @default(30)
  availability             Json    @default("[]") // [{ dayOfWeek: 0-6, start: "09:00", end: "18:00" }]
  appointmentReminderHours Int     @default(24) // quantas horas antes do compromisso enviar a confirmação
  requisitosAgendamento    String  @default("") // informações que o agente deve coletar antes de confirmar o horário
  restricoesAgendamento        String  @default("") // o que o agente NÃO deve fazer no agendamento
  atendimentoEspecialEnabled   Boolean @default(false) // permite oferecer horários fora do comercial
  atendimentoEspecialDescricao String  @default("") // condições do atendimento especial
  askProfessionalEnabled       Boolean @default(true) // com vários profissionais: true = agente pergunta com quem; false = atribui a qualquer um livre
  schedulingViaLink            Boolean @default(false) // true = a IA envia o link da página pública (/agendar) em vez de marcar por mensagem
  agendarAteEncerramento       Boolean @default(false) // aceita horário que começa dentro do funcionamento mesmo terminando após o fechamento
  vagasSimultaneas             Int     @default(1) // atendimentos simultâneos sem profissional (ex: lava-jato com 3 vagas)
  agendamentoCobrancaEnabled   Boolean @default(false) // cobra sinal via Pix pra confirmar agendamento na página pública
  agendamentoSinalValor        Float   @default(0) // valor do sinal em reais
  bookingFormFields            Json    @default("[]") // campos extras do agendamento pelo link: [{ label, obrigatorio }] — nome e WhatsApp são sempre pedidos
  agendaAccessToken            String? @unique // link da agenda geral da empresa (/agenda/[token], PWA)

  // Como conversas novas são distribuídas entre os atendentes da equipe
  leadDistributionMode LeadDistributionMode @default(MANUAL)
  lastAssignedToId     String? // último atendente que recebeu um lead no rodízio/IA — marca a posição da fila

  // Quem a IA atende quando está ligada — critérios opcionais, sem efeito quando vazios/false.
  // A mensagem sempre é salva (escuta ativa); os critérios só decidem se a IA GERA resposta
  // automática agora — quando excluem, dispara a mesma notificação de humanTakeover pra equipe
  // não perder a mensagem.
  iaIgnoraAtribuidos        Boolean @default(false) // true = não responde conversa que já tem vendedor
  iaNiveisCarteiraExcluidos Json    @default("[]")   // ["A","B","C","INATIVO","PERDIDO"] — nível manual/importado, não o calculado automático

  // Transferência automática pra humano quando o cliente pede foto/imagem (a IA não consegue
  // enviar mídia) — expõe a tool transferir_atendente_foto só quando ativo.
  transferirAoPedirFoto Boolean @default(false)

  // Condições em texto livre definidas pelo gestor (ex: "cliente pede desconto acima de 20%")
  // — quando a situação bate com alguma delas, a IA chama transferir_atendente_condicao. Expõe
  // a tool só quando a lista não está vazia (ver whatsapp-inbound.ts).
  transferenciaCondicoes String[] @default([])

  // Vendedor que recebe os leads que a IA transfere (hoje só transferirAoPedirFoto) — só entra
  // em ação se a conversa ainda não tem dono, nunca rouba de quem já assumiu.
  // null/"" = segue leadDistributionMode normalmente; "RODIZIO" = alterna entre os atendentes
  // da equipe; um profileId = sempre esse vendedor.
  iaLeadAttendantId String?

  // Instruções adicionais em texto livre — anexadas ao final do systemPrompt gerado pelo
  // wizard (Personalidade/Sobre a empresa/Configuração comercial), sem substituí-lo. Espaço
  // pro gestor detalhar persona, objetivo, tom, restrições e exemplos que o wizard não cobre.
  instrucoesExtras String @default("")

  // Treino (RAG por exemplo, ver TreinoExemplo): quantos exemplos entram no prompt e a
  // similaridade de cosseno mínima pra considerar um exemplo relevante o suficiente
  treinoSimilaridadeMinima Float @default(0.5)
  treinoMaxExemplos        Int   @default(2)

  // Quando ativo, mensagens manuais de atendentes saem no WhatsApp assinadas com o nome de quem mandou
  signatureEnabled Boolean @default(false)
  emojiEnabled     Boolean @default(false) // permite que o agente de IA use emojis nas respostas

  // Espera antes de começar a enviar a resposta da IA — simula "lendo/digitando", 0 = instantâneo
  responseDelaySeconds Int @default(0)
  // Assina as respostas da IA com o nome do agente, como uma bolha extra no fim (diferente de
  // signatureEnabled, que assina mensagens manuais de atendente com o nome de quem mandou)
  agentSignatureEnabled Boolean @default(false)

  // Catálogo/pedidos via WhatsApp com pagamento Pix/cartão (Asaas) — cada equipe usa a própria conta
  commerceEnabled  Boolean @default(false)
  catalogOnly      Boolean @default(false) // true = só catálogo/pedidos, sem gerar cobrança online
  catalogType      CatalogType @default(GENERICO) // define os campos do produto e o comportamento do catálogo/IA
  asaasApiKey      String? // colada pelo gestor, nunca exibida de volta na UI
  asaasSandbox     Boolean @default(true)
  asaasWebhookToken String? // gerado ao ativar; valida o webhook de confirmação de pagamento

  // Pré-vendas de veículos (SDR) — fluxo estruturado opcional, só relevante quando
  // catalogType = VEICULOS. A transferência final respeita leadDistributionMode (não força
  // atribuição própria).
  prevendaVeiculoEnabled    Boolean @default(false)
  prevendaVeiculoRestricoes String  @default("") // texto livre do gestor, injetado no prompt como "NUNCA FAÇA"
  // Cada etapa de coleta liga/desliga independente (a transferência final não é opcional —
  // é o mecanismo de saída do fluxo, sempre ativa quando prevendaVeiculoEnabled é true).
  prevendaEtapaVeiculoEnabled       Boolean @default(true) // identificar veículo de interesse
  prevendaEtapaQualificacaoEnabled  Boolean @default(true) // pagamento/troca/entrada/parcela/urgência
  prevendaEtapaDocumentosEnabled    Boolean @default(true) // documentos pra financiamento

  cobrancaEnabled Boolean @default(false) // agente dedicado a cobrança de dívidas/boletos

  // Prospecção ativa via Google Maps + WhatsApp
  prospeccaoEnabled          Boolean @default(false)
  prospeccaoSegmento         String  @default("") // ex: "dentistas"
  prospeccaoRegiao           String  @default("") // ex: "São Paulo SP"
  prospeccaoMensagemInicial  String  @default("") // template da 1ª mensagem ao prospect
  prospeccaoFollowupDias     Json    @default("[3,7,14]") // dias entre follow-ups
  // Ritmo do disparo — mesmas 3 opções de Campanha (seguro/moderado/rapido), resolvidas pro
  // intervalo em segundos no cron. Guardado como escolha (não min/max já resolvidos) porque
  // a prospecção é uma configuração contínua do agente, não um disparo único como Campanha.
  prospeccaoRitmo            String  @default("seguro")
  // Throttle: o cron processa no máximo 1 abordagem/follow-up de prospecção por agente a cada
  // execução, e só volta a mexer nesse agente depois desse horário — evita disparar dezenas/
  // centenas de mensagens frias de uma vez (risco real de banimento do número).
  prospeccaoNextSendAt       DateTime?

  // Parcelamento no cartão — o acréscimo de juros é calculado por nós (não pela conta Asaas)
  // e embutido no valor total enviado, pra não depender de configuração externa
  installmentsEnabled     Boolean @default(false)
  maxInstallments         Int     @default(1)
  interestFreeInstallments Int    @default(1) // até quantas parcelas não tem acréscimo
  installmentInterestRate Float   @default(0) // % de acréscimo por parcela além das sem juros

  // O agente de IA move leads pelas etapas do pipeline conforme a conversa evolui
  pipelineAutoAvancar Boolean @default(false)

  // Metas de vendas mensais (reiniciam todo mês, comparadas ao valor ganho no mês corrente
  // nos dashboards) — configuradas em Configurações > Metas.
  metaGeralMensal   Float @default(0) // 0 = sem meta geral definida
  metasPorVendedor  Json  @default("{}") // { [profileId]: valorMensal }

  // Investimento mensal em marketing/vendas — usado só pra calcular CAC no dashboard
  // (custo por cliente adquirido = investimento do mês ÷ clientes novos no mês). Também
  // reinicia todo mês, sem histórico, igual às metas.
  investimentoMensal Float @default(0)

  // Agente de ligação via Twilio + ElevenLabs
  phoneEnabled         Boolean @default(false)
  twilioAccountSid     String?
  twilioAuthToken      String?
  twilioPhoneNumber    String? // número Twilio de origem, ex: +5511...
  elevenlabsApiKey       String?
  elevenlabsVoiceId      String? // ID da voz no ElevenLabs
  phoneCallPrompt        String  @default("") // instruções extras para ligações
  whatsappVoiceEnabled   Boolean @default(false) // responder por áudio de voz no WhatsApp (nunca junto com o texto)
  whatsappVoicePercent   Int     @default(30) // % de respostas enviadas como áudio (resto é texto)

  // Resposta automática a comentários do Instagram via DM
  igCommentAutoDm    Boolean @default(false)
  igCommentDmMessage String? // fallback quando nenhum fluxo bate — null = IA responde

  // Coleta de WhatsApp via DM do Instagram — opcional. Quando ativo, a IA é instruída a buscar o
  // número de WhatsApp do lead como objetivo, e o número detectado dispara handoff automático
  // pro WhatsApp (ver app/api/webhooks/instagram/route.ts).
  igColetaWhatsappEnabled     Boolean @default(false)
  igColetaWhatsappInstrucoes String  @default("") // texto livre do gestor: como/quando pedir o número

  // Agente de gestão de carteira: pós-venda e recompra automáticos (via cron /api/cron/carteira)
  carteiraEnabled    Boolean @default(false)
  // Agente de Pós-venda (independente da carteira): mensagem pós-compra + pesquisa de satisfação
  posVendaEnabled    Boolean @default(false)
  posVendaDelayHours Int     @default(24)    // horas depois do pagamento
  posVendaMensagem   String  @default("")    // template fixo ({nome} = cliente); vazio = IA gera
  posVendaPesquisaEnabled Boolean @default(true) // pede nota de 0 a 5 na mensagem de pós-venda
  posVendaReviewLink      String  @default("")   // link de avaliação (Google) enviado quando a nota é alta
  posVendaFeedbacks       PosVendaFeedback[]
  // Agente de Recompra (independente): reativação de quem não compra há X dias
  recompraEnabled    Boolean @default(false)
  recompraDias       Int     @default(30)
  carteiraInstrucoes String  @default("")    // orientações pra IA (ofertas, tom, cupons)
  carteiraInativoDias Int    @default(60)    // dias sem compra para nível INATIVO (15/30/60/90/120)

  // Identidade visual do catálogo público (/loja) — logo base64 como as fotos de produto
  storeLogoBase64   String? @db.Text
  storeLogoMimeType String?
  storeSlug         String? @unique // URL amigável do catálogo (/loja/nome-da-loja), gerada do nome da empresa

  // Integração com o sistema do cliente: pedidos (criado/atualizado/pago) são enviados
  // por POST para essa URL, assinados com HMAC-SHA256 quando o secret está definido
  orderWebhookUrl    String?
  orderWebhookSecret String?

  // Opções de entrega do comércio
  deliveryEnabled   Boolean @default(false) // oferece entrega
  pickupEnabled     Boolean @default(true)  // oferece retirada no local
  deliveryFee       Float   @default(0)     // taxa padrão — usada quando não há zonas cadastradas
  deliveryFreeAbove Float?                  // frete grátis a partir desse subtotal (null = nunca)
  deliveryArea      String  @default("")    // área atendida, prazos, observações
  deliveryZones     DeliveryZone[]          // zonas com taxa própria (bairro/região)

  conversations        Conversation[]
  phoneCalls           PhoneCall[]
  pipelines            Pipeline[]
  leadStatuses         LeadStatus[]
  etiquetas            Etiqueta[]
  conhecimentoItens    ConhecimentoItem[]
  appointments         Appointment[]
  professionals        Professional[]
  services             Service[]
  quickReplies         QuickReply[]
  products             Product[]
  orders               Order[]
  cobrancas            Cobranca[]
  prospects            Prospect[]
  instagramConnection  InstagramConnection?
  igCommentFlows       InstagramCommentFlow[]
  igFunnels            InstagramFunnel[]
  storeBanners         StoreBanner[]
  carteiraTouches      CarteiraTouch[]
  automacoes           Automacao[]
  campanhas            Campanha[]
  motivosPerda         MotivoPerda[]
  treinoExemplos       TreinoExemplo[]

  @@index([teamId])
}

// Avaliação de satisfação coletada pelo agente de pós-venda
model PosVendaFeedback {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  contactNumber String
  contactName   String  @default("")
  rating        Int     // 0 a 5
  comment       String  @default("")

  @@index([agentConfigId, createdAt])
}

// Campanha de disparo em massa via WhatsApp — processada pelo cron /api/cron/campanhas
// com intervalo aleatório entre envios (anti-bloqueio)
model Campanha {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  nome     String
  mensagem String // mensagem base ({nome} = primeiro nome do contato) — usada quando origemMensagem = TEXTO_LIVRE
  modo     String @default("NORMAL") // NORMAL | IA_VARIACAO (IA reescreve por destinatário) — só se aplica a TEXTO_LIVRE
  instrucoesIA String @default("")   // orientações extras pra variação (tom, o que preservar)

  // Envio via template aprovado da Meta — obrigatório quando o agente usa WhatsApp Cloud API
  origemMensagem    CampanhaOrigemMensagem @default(TEXTO_LIVRE)
  templateName      String?
  templateLanguage  String?
  templateVariaveis String? // JSON: array posicional; cada item é texto fixo ou o token "{nome}"

  status String @default("ENVIANDO") // ENVIANDO | PAUSADA | CONCLUIDA | CANCELADA

  intervaloMinSeg Int @default(45)
  intervaloMaxSeg Int @default(120)
  nextSendAt      DateTime?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?

  destinatarios CampanhaDestinatario[]

  @@index([agentConfigId])
  @@index([status, nextSendAt])
}

model CampanhaDestinatario {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  campanhaId String
  campanha   Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  contactNumber String
  contactName   String  @default("")
  status        String  @default("PENDENTE") // PENDENTE | ENVIADO | ERRO
  mensagemEnviada String?
  sentAt        DateTime?

  @@index([campanhaId, status])
}

// Registro de cada toque automático da gestão de carteira — evita duplicar envios
model CarteiraTouch {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  contactNumber String
  type          String  // "POS_VENDA" | "RECOMPRA"
  orderId       String? // pós-venda: pedido que originou o toque

  @@index([agentConfigId, contactNumber, type])
  @@index([agentConfigId, orderId])
}

// Zona de entrega com taxa própria (ex: "Centro" R$ 5, "Zona Norte" R$ 12)
model DeliveryZone {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name  String
  fee   Float  @default(0)
  order Int    @default(0)

  @@index([agentConfigId])
}

// Banner do carrossel de destaque no topo do catálogo público (/loja)
model StoreBanner {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  imagemBase64   String  @db.Text
  imagemMimeType String
  order          Int     @default(0)
  active         Boolean @default(true)

  @@index([agentConfigId])
}

enum LeadDistributionMode {
  MANUAL              // ninguém é atribuído automaticamente
  PRIMEIRO_A_ASSUMIR  // quem mandar a 1ª mensagem manual na conversa fica responsável
  RODIZIO             // toda conversa nova já nasce atribuída, alternando entre atendentes
  IA_QUALIFICACAO     // a IA avalia a conversa e atribui (rodízio) quando o lead parece qualificado
}

enum WhatsappProvider {
  UAZAPI    // pareamento por QR code, não oficial
  CLOUD_API // WhatsApp Cloud API oficial da Meta
}

enum CampanhaOrigemMensagem {
  TEXTO_LIVRE  // mensagem digitada, com {nome} interpolado (UazAPI ou Cloud API dentro da janela de 24h)
  TEMPLATE_META // template aprovado pela Meta, obrigatório para campanhas via WhatsApp Cloud API
}

// Se a empresa não cadastrar nenhum profissional, o agendamento usa a disponibilidade
// e duração padrão do AgentConfig (modo "agenda única"). Ao cadastrar profissionais,
// cada um passa a ter sua própria disponibilidade e os agendamentos exigem escolha de profissional.
model Professional {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name         String
  phone        String  @default("") // WhatsApp do profissional — notificado a cada agendamento
  accessToken  String? @unique      // token do link da agenda PWA do profissional (/agenda/[token])
  availability Json    @default("[]") // [{ dayOfWeek: 0-6, start: "09:00", end: "18:00" }]
  active       Boolean @default(true)

  appointments         Appointment[]
  pendingInConversations Conversation[]
}

// Se a empresa não cadastrar nenhum serviço, o agendamento usa slotDurationMinutes do
// AgentConfig. Ao cadastrar serviços, cada um define sua própria duração.
model Service {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name            String
  durationMinutes Int
  active          Boolean @default(true)

  appointments           Appointment[]
  pendingInConversations Conversation[]
}

// ─── Agente de Prospecção ────────────────────────────────────────────────────

enum ProspectStatus {
  NOVO            // scraped, ainda não abordado
  ABORDADO        // primeira mensagem enviada, aguardando resposta
  RESPONDEU       // prospect mandou mensagem, IA qualificando
  QUALIFICADO     // lead bom, encaminhado para atendente humano
  REUNIAO_AGENDADA
  DESCARTADO      // sem perfil ou pediu para parar
  ENCERRADO       // follow-ups esgotados sem resposta
}

model Prospect {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  nome           String
  empresa        String @default("")
  telefone       String
  segmento       String @default("")
  regiao         String @default("")
  sourceUrl      String @default("") // URL da ficha no Google Maps
  status         ProspectStatus @default(NOVO)
  notas          String @default("")  // anotações da qualificação pela IA

  abordagemCount  Int      @default(0) // total de mensagens proativas enviadas
  lastAbordagemAt DateTime?

  @@unique([agentConfigId, telefone]) // evita duplicar o mesmo número no mesmo agente
}

// ─── Agente de Cobrança ──────────────────────────────────────────────────────

enum CobrancaStatus {
  PENDENTE       // registrada, ainda não enviou boleto
  BOLETO_GERADO  // boleto gerado e enviado ao devedor
  PAGO           // confirmação de pagamento recebida
  VENCIDA        // prazo expirou e não foi pago
  CANCELADA
}

enum RecorrenciaCobranca {
  UNICA
  SEMANAL
  QUINZENAL
  MENSAL
  ANUAL
}

model Cobranca {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  nomeDevedor   String
  contactNumber String   // WhatsApp do devedor, só números
  cpfCnpj       String?  // CPF ou CNPJ do devedor (exigido pelo Asaas para gerar boleto)
  valor         Float
  descricao     String   @default("")
  vencimento    DateTime
  status        CobrancaStatus      @default(PENDENTE)
  recorrencia   RecorrenciaCobranca @default(UNICA)

  asaasCustomerId String?
  asaasPaymentId  String?
  boletoUrl       String?  // bankSlipUrl retornado pelo Asaas

  paidAt         DateTime?
  reminderCount  Int      @default(0) // quantos lembretes de follow-up já foram enviados
  lastReminderAt DateTime?
}

// ─── Catálogo do agente de comércio ──────────────────────────────────────────
// Catálogo do agente de comércio — o agente consulta isso antes de informar preço/estoque,
// nunca inventa produto ou valor fora dessa lista.
model Product {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name              String
  description       String  @default("")
  category          String  @default("") // texto livre; "" = sem categoria (aparece por último no catálogo)
  price             Float
  precoPromocional  Float?  // null = sem promoção ativa; quando definido, sobrepõe o preço normal
  stock             Int?    // null = não controla estoque
  active            Boolean @default(true)

  // Foto guardada como base64 direto no banco (sem prefixo "data:...;base64,") — o projeto
  // não tem storage de blob hoje, e o envio pelo WhatsApp (sendMediaAsTeam) já pede base64 puro.
  imagemBase64   String? @db.Text
  imagemMimeType String?

  // Campos de Veículos — só usados quando AgentConfig.catalogType = VEICULOS
  marca           String?
  modelo          String?
  anoFabricacao   Int?
  anoModelo       Int?
  km              Int?
  cor             String?
  cambio          Cambio?
  combustivel     Combustivel?
  placa           String? // uso interno — nunca exposto na loja pública nem enviado pra IA/cliente
  condicaoVeiculo CondicaoVeiculo?

  // Campos de Imóveis — só usados quando AgentConfig.catalogType = IMOVEIS
  tipoNegocio  TipoNegocioImovel?
  tipoImovel   TipoImovel?
  areaM2       Float?
  quartos      Int?
  banheiros    Int?
  vagasGaragem Int?
  bairro       String?
  cidade       String?

  // Fotos extras (galeria) — Veículos/Imóveis costumam ter várias fotos; a foto de capa
  // continua em imagemBase64 acima (usada nas miniaturas do CRM e por enviar_foto_produto)
  images ProductImage[]

  orderItems OrderItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  imagemBase64   String @db.Text
  imagemMimeType String
  order          Int    @default(0)

  @@index([productId])
}

enum CatalogType {
  GENERICO
  VEICULOS
  IMOVEIS
}

enum Cambio {
  MANUAL
  AUTOMATICO
}

enum Combustivel {
  FLEX
  GASOLINA
  ETANOL
  DIESEL
  ELETRICO
  HIBRIDO
  GNV
}

enum CondicaoVeiculo {
  NOVO
  SEMINOVO
  USADO
}

enum TipoNegocioImovel {
  VENDA
  ALUGUEL
}

enum TipoImovel {
  CASA
  APARTAMENTO
  COMERCIAL
  TERRENO
}

enum OrderStatus {
  ABERTO // carrinho em montagem, ainda sem cobrança gerada
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Order {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  agentConfigId  String
  agentConfig    AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  contactName   String
  contactNumber String
  status        OrderStatus @default(ABERTO)
  total         Float       @default(0) // subtotal dos itens (sem taxa de entrega)

  deliveryType    String? // "ENTREGA" | "RETIRADA" — null = ainda não definido
  deliveryFee     Float   @default(0)
  deliveryAddress String  @default("")
  deliveryZone    String  @default("") // nome da zona escolhida, quando a loja usa zonas

  asaasPaymentId  String?
  asaasPixPayload String? // código Pix copia-e-cola
  asaasInvoiceUrl String? // link de checkout hospedado (usado pra pagamento por cartão)
  asaasInstallmentId String? // id do plano de parcelas no Asaas, quando a cobrança é parcelada
  paidAt          DateTime?

  items OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String // snapshot do nome no momento do pedido
  unitPrice Float  // snapshot do preço no momento do pedido
  quantity  Int
}

// Textos prontos que qualquer atendente pode inserir rápido no chat (ex: saudações,
// respostas padrão). Compartilhadas por toda a equipe do número.
model QuickReply {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  title   String // nome curto pra identificar na lista, ex: "Saudação"
  content String

  automacoes Automacao[]
}

// Automação determinística do pipeline (sem IA): quando a mensagem rápida vinculada
// é enviada pelo atendente, o lead move automaticamente para a etapa configurada.
model Automacao {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  nome   String
  active Boolean @default(true)

  trigger String @default("QUICK_REPLY") // extensível: futuros gatilhos (pedido pago, agendamento...)

  quickReplyId String
  quickReply   QuickReply @relation(fields: [quickReplyId], references: [id], onDelete: Cascade)

  targetStageId String
  targetStage   PipelineStage @relation(fields: [targetStageId], references: [id], onDelete: Cascade)

  @@index([agentConfigId])
}

model Appointment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  contactName   String?
  contactNumber String

  scheduledAt     DateTime
  durationMinutes Int      @default(30)
  notes           String   @default("")
  status          AppointmentStatus @default(CONFIRMADO)

  reminderSentAt DateTime? // quando o lembrete de confirmação foi enviado (evita reenvio)

  // Sinal via Asaas (página pública com cobrança pra confirmar)
  asaasPaymentId  String?
  asaasPixPayload String? @db.Text
  asaasInvoiceUrl String?
}

enum AppointmentStatus {
  CONFIRMADO
  CANCELADO
  CONCLUIDO
  AGUARDANDO_PAGAMENTO // reserva aguardando o Pix do sinal (expira em 30 min — ver PENDING_HOLD_MS)
}

// Uma empresa pode ter vários pipelines (ex: Vendas, Suporte). Cada conversa fica em uma
// etapa por vez, e a etapa pertence a um único pipeline — então o pipeline "atual" da
// conversa é sempre o do stage em que ela está.
model Pipeline {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name  String
  order Int    @default(0)

  // Agente responsável pelo funil inteiro: instruções aplicadas a leads em qualquer
  // etapa deste pipeline (as instruções da etapa refinam por cima)
  agenteInstrucoes String @default("")

  stages PipelineStage[]
}

model PipelineStage {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name  String
  color String @default("#3b82f6")
  order Int    @default(0)

  // Agente responsável pela etapa: instruções que moldam o comportamento da IA
  // enquanto o lead estiver nesta etapa do funil (prioridade sobre o prompt geral)
  agenteInstrucoes String @default("")

  // Follow-up automático por tempo parado na etapa (independe de quem mandou a última
  // mensagem — diferente do follow-up global do agente). [] = desativado nesta etapa.
  // Minutos por tentativa, ex: [1440, 2880] = 1ª após 24h parado, 2ª +48h depois.
  followupDelaysMinutes Json @default("[]")

  opportunities Opportunity[]
  automacoes    Automacao[]
}

model LeadStatus {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name  String
  color String @default("#6b7280")
  order Int    @default(0)

  conversations Conversation[]
}

// Etiqueta estilo WhatsApp Business — um contato pode ter várias ao mesmo tempo
// (diferente do LeadStatus, que é um só por conversa)
model Etiqueta {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  nome String
  cor  String @default("#6b7280")

  conversations Conversation[]

  @@index([agentConfigId])
}

// Base de conhecimento do agente — conteúdos (FAQs, regras, infos da empresa) que a IA
// injeta no prompt de toda resposta pra atender com precisão
model ConhecimentoItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  titulo   String
  conteudo String  @db.Text
  active   Boolean @default(true)

  @@index([agentConfigId])
}

// Exemplo de atendimento simulado, usado como RAG (retrieval por similaridade de embedding)
// pra guiar a IA em conversas reais — em vez de fine-tuning. Cadastrado pelo gestor: um
// cenário curto + uma conversa de exemplo em turnos cliente/assistente. O embedding é
// calculado a partir de "cenario + primeira fala do cliente" e comparado, em tempo de
// resposta, contra o embedding da mensagem real do cliente (ver lib/embeddings.ts).
model TreinoExemplo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  cenario String // título curto do cenário, ex: "Cliente pede foto do produto"
  turnos  Json   // array de { role: "user" | "assistant", content: string }, em ordem

  // Embedding de "cenario + primeira fala do cliente" (text-embedding-3-small, 1536 dims) —
  // null até o cálculo terminar; falha na chamada da OpenAI não impede salvar o exemplo,
  // só deixa sem embedding (não entra no retrieval até ser reprocessado)
  embedding Json?

  createdById String
  createdBy   Profile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([agentConfigId])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  contactNumber  String
  contactName    String?
  status         ConversationStatus @default(ATIVO)
  humanTakeover  Boolean            @default(false) // true = atendente humano assumiu, agente para de responder

  // Grupo do WhatsApp (contactNumber = id do grupo, contactName = nome do grupo) — IA nunca
  // responde automaticamente aqui (ver shouldAiHandle em lib/whatsapp-inbound.ts), só atendente.
  isGroup Boolean @default(false)

  // Só relevante quando isGroup — lista de profileId que podem ver esse grupo específico.
  // Vazio = visível pra equipe inteira (padrão, compatível com grupos já existentes). Gestor
  // configura pelo cabeçalho do chat do grupo.
  groupVisibleToIds String[] @default([])

  // Conversa de teste do simulador (Ferramentas > Treino) — uma por gestor, reaproveitada entre
  // sessões. Nunca deve aparecer na caixa de entrada nem em relatórios/métricas reais.
  isSandbox Boolean @default(false)

  leadStatusId String?
  leadStatus   LeadStatus? @relation(fields: [leadStatusId], references: [id], onDelete: SetNull)

  // Nível manual da carteira ("A"|"B"|"C"|"INATIVO"|"PERDIDO") — null = calculado automaticamente.
  // Usado p.ex. quando o cliente informa que passou a comprar de outro fornecedor (PERDIDO).
  nivelCarteira String?

  // Departamento responsável pela conversa (setado pela IA na transferência ou manualmente)
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  // Encerramento: motivo escolhido pelo atendente + quando — base do relatório de motivos
  motivoEncerramento String?
  encerradaEm        DateTime?

  // Atendente responsável por essa conversa — null = ainda não atribuída (qualquer atendente
  // pode ver e assumir). Quem atribui/quando depende do leadDistributionMode do AgentConfig.
  assignedToId String?
  assignedTo   Profile? @relation("AssignedConversations", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Etiquetas estilo WhatsApp Business — várias por contato, cadastradas por agente
  etiquetas Etiqueta[]

  followupCount  Int       @default(0)
  lastFollowupAt DateTime?

  // Marcado quando alguém da equipe abre a conversa — usado pro filtro "não lidas".
  // É global (não por usuário): se alguém já leu, conta como lida pra todo mundo.
  lastReadAt DateTime?

  // Fixa a conversa no topo da lista, manualmente
  pinned Boolean @default(false)

  // Memoriza o último serviço/profissional que a IA resolveu nessa conversa, pra usar como
  // fallback em agendar_horario caso o modelo não repita o parâmetro na chamada de confirmação.
  pendingProfessionalId String?
  pendingProfessional   Professional? @relation(fields: [pendingProfessionalId], references: [id], onDelete: SetNull)
  pendingServiceId      String?
  pendingService        Service?      @relation(fields: [pendingServiceId], references: [id], onDelete: SetNull)

  // Cacheia o customer já criado no Asaas pra esse contato, evita recriar a cada pedido
  asaasCustomerId String?

  // Preenchido quando detectamos um número de WhatsApp na conversa do Instagram — trava o
  // gatilho pra não reprocessar a cada mensagem nova (só a 1ª detecção dispara o contato)
  extractedWhatsappNumber String?

  messages          Message[]
  appointments      Appointment[]
  opportunities     Opportunity[]
  scheduledMessages ScheduledMessage[]
  orders            Order[]
  phoneCalls        PhoneCall[]

  @@unique([agentConfigId, contactNumber])
}

// Uma negociação dentro de uma conversa — um mesmo cliente pode ter várias (ex: comprou,
// depois volta pra negociar outra coisa). Cada uma tem seu próprio valor, etapa e status de ganho.
model Opportunity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  stageId        String?
  stage          PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageEnteredAt DateTime       @default(now()) // atualizado sempre que stageId muda, pra calcular "dias parado nessa etapa"

  // Contagem do follow-up automático da etapa atual — zerada sempre que stageId muda
  // (junto com stageEnteredAt), já que as tentativas são por tempo parado NESSA etapa.
  stageFollowupCount  Int       @default(0)
  lastStageFollowupAt DateTime?

  title     String? // nome opcional pra diferenciar quando há mais de uma, ex: "Plano anual"
  dealValue Float
  wonAt     DateTime? // quando foi marcada como ganha (null = ainda em negociação)
  lostAt    DateTime? // quando foi marcada como perdida

  motivoPerdaId String?
  motivoPerda   MotivoPerda? @relation(fields: [motivoPerdaId], references: [id], onDelete: SetNull)

  tasks OpportunityTask[]
  files OpportunityFile[]
}

// Motivo de perda configurável (ex: "Preço", "Escolheu concorrente", "Sem resposta") —
// escolhido pelo atendente ao marcar uma negociação como perdida, pra virar relatório
// em vez de texto livre solto. Gerenciado em Configurações > Motivos de perda.
model MotivoPerda {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  nome String

  oportunidades Opportunity[]
}

// Tarefa/checklist de uma oportunidade — ex: "ligar até sexta", "enviar proposta"
model OpportunityTask {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  title   String
  done    Boolean   @default(false)
  dueDate DateTime?

  assignedToId String?
  assignedTo   Profile? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
}

// Arquivo interno anexado a uma oportunidade (contrato, documento, print) — nunca é enviado
// ao cliente pelo WhatsApp, só visível pra equipe na aba Arquivos do modal de detalhes.
// Base64 direto no banco, mesma convenção já usada pra imagem de produto (sem blob storage).
model OpportunityFile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fileName String
  mimeType String
  base64   String @db.Text

  uploadedById String
  uploadedBy   Profile @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

// Agendamento de demonstração do CRM pela própria equipe (plataforma, não por AgentConfig) —
// aba "Recursos" da página de início. Horário fixo (lib/demo-scheduling.ts), sem conceito de
// profissional/serviço como o agendamento público em app/agendar/[agentId].
model DemoBooking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   Profile @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  scheduledAt     DateTime
  durationMinutes Int      @default(40)
  status          String   @default("AGENDADO") // AGENDADO | CANCELADO

  @@index([teamId])
  @@index([scheduledAt])
}

// Mensagem de texto programada pra ser enviada automaticamente numa data/hora futura —
// o cron de followup verifica e dispara quando chega a hora.
model ScheduledMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   Profile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  content      String
  scheduledFor DateTime
  sentAt       DateTime? // null = ainda não enviada
}

enum ConversationStatus {
  ATIVO
  AGUARDANDO
  FINALIZADO
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String // user | assistant | human
  content String

  mediaUrl  String? // url pública (já descriptografada via UazAPI) da mídia, se houver
  mediaType String? // image | video | audio | document

  edited  Boolean @default(false) // texto editado depois de enviada (POST /message/edit na UazAPI)
  deleted Boolean @default(false) // apagada para todos no WhatsApp (POST /message/delete) — conteúdo fica só de auditoria

  senderId String?  // qual atendente mandou (role "human"), pra CRM multiusuário
  sender   Profile? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  // Nome de quem mandou dentro de um grupo do WhatsApp (role "user", conversation.isGroup) —
  // cada mensagem pode ser de uma pessoa diferente do grupo, não dá pra usar o contato da
  // conversa (que é o grupo em si) pra identificar o remetente.
  groupSenderName String?

  // Reply/encaminhar estilo WhatsApp
  waMessageId String? // id da mensagem no provedor (UazAPI messageid / Cloud wamid) — habilita citação nativa
  forwarded   Boolean @default(false)
  replyToId   String?
  replyTo     Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies     Message[] @relation("MessageReply")

  @@index([conversationId, waMessageId])
}

// ─── Controle de consumo de tokens de IA ─────────────────────────────────────

model TokenUsageLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  provider     String   // "openai" | "anthropic"
  model        String   // "gpt-4o-mini" | "claude-sonnet-4-6"
  feature      String   // "whatsapp_agent" | "followup" | "plano" | "missao" | "script" | "objecao" | "scanner" | "simulacao"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)

  @@index([teamId, createdAt])
}

// Compra de créditos extras de IA (top-up), pagamento único via Asaas (conta da plataforma)
model CreditoCompra {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  packId         String // id do pacote em lib/credits.ts, ex: "popular"
  tokens         Int
  valorCentavos  Int
  status         String  @default("PENDENTE") // PENDENTE | PAGO
  formaPagamento String  // PIX | CARTAO
  cpfCnpj        String  @default("")

  asaasPaymentId  String? @unique
  asaasInvoiceUrl String? // link hospedado do Asaas (usado no pagamento por cartão)
  asaasPixPayload String? // código Pix copia-e-cola

  @@index([teamId, createdAt])
}

// Compra de plano do CRM (aba Recursos > Ver planos) — mesma cobrança avulsa via Asaas
// Pix/Cartão da conta da plataforma que CreditoCompra já usa, só que atualiza
// Team.crmPlanTier em vez de somar créditos (ver app/api/webhooks/asaas-plataforma).
model PlanPurchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  tier           String // STARTER | ESSENTIAL | PRO | BUSINESS — ver lib/crm-plans.ts
  cycle          String @default("MENSAL") // MENSAL | SEMESTRAL | ANUAL
  valorCentavos  Int    // total cobrado (à vista) — cobre o ciclo inteiro, não só um mês
  status         String @default("PENDENTE") // PENDENTE | PAGO
  formaPagamento String // PIX | CARTAO
  cpfCnpj        String @default("")

  asaasPaymentId  String? @unique
  asaasInvoiceUrl String?
  asaasPixPayload String?

  @@index([teamId, createdAt])
}

// Planos do CRM oferecidos na aba Recursos > Ver planos — editável pelo super admin em
// /admin/planos. `id` é o slug usado como referência solta em PlanPurchase.tier (sem FK,
// então excluir um tier não quebra o histórico de quem já comprou, mas o rótulo some da
// tela; por isso o campo `active` existe pra "aposentar" um plano sem perder esse histórico).
// Preço de cada ciclo é o total cobrado à vista (não parcelado); o valor "por mês" exibido
// pro semestral/anual é sempre derivado (total / meses do ciclo), nunca guardado à parte.
model CrmPlanTier {
  id          String   @id // slug: STARTER, ESSENTIAL, PRO, BUSINESS, ou um novo criado pelo admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  label       String
  description String  @default("")
  destaque    Boolean @default(false) // selo "Recomendado" na grade de planos
  order       Int     @default(0)
  active      Boolean @default(true)  // desmarcado = some da grade pública, mas continua existindo
  features    Json    @default("[]")  // string[] — lista de bullets exibidos no card

  precoMensalCentavos    Int @default(0) // total do ciclo MENSAL
  precoSemestralCentavos Int @default(0) // total à vista do ciclo SEMESTRAL (6 meses)
  precoAnualCentavos     Int @default(0) // total à vista do ciclo ANUAL (12 meses)

  @@index([active, order])
}

// Textos das mensagens automáticas que a PRÓPRIA plataforma dispara pelo WhatsApp da
// instância global (UAZAPI_TOKEN, não a de cada equipe) durante o funil de venda/onboarding
// do CRM — cadastro de conta e agendamento de demonstração. Editável pelo super admin em
// /admin/mensagens. `id` é fixo por evento (não criável/removível pelo admin, só o texto
// muda); `placeholders` é só documentação exibida na tela pra saber o que dá pra usar no
// corpo — a substituição de verdade acontece em lib/message-templates.ts.
model MessageTemplate {
  id          String   @id // WELCOME_GESTOR | WELCOME_VENDEDOR | WELCOME_FUNCIONARIO | DEMO_CONFIRMACAO
                            // | TRIAL_CHECKLIST_NUDGE | TRIAL_DEMO_INVITE | TRIAL_SOCIAL_PROOF_1/2/3
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  label        String
  description  String @default("")
  body         String @db.Text
  placeholders Json   @default("[]") // string[] — nomes dos placeholders aceitos, ex: ["name","companyName"]
}

// Marca quais etapas do funil de acompanhamento do teste grátis (ver lib/trial-funnel.ts)
// já foram processadas pra cada equipe — evita reenviar a mesma etapa a cada execução do
// cron. Gravado mesmo quando a etapa é pulada por condição (ex: checklist já em andamento),
// não só quando a mensagem sai de fato, pra não ficar reavaliando a condição pra sempre.
model TrialFunnelSent {
  id     String   @id @default(cuid())
  teamId String
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stepId String
  sentAt DateTime @default(now())

  @@unique([teamId, stepId])
}

// ─── Agente de Ligação (Twilio + ElevenLabs) ─────────────────────────────────

enum PhoneCallStatus {
  EM_ANDAMENTO
  CONCLUIDA
  PERDIDA
  FALHADA
}

model PhoneCall {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  direction     String          // "INBOUND" | "OUTBOUND"
  contactNumber String
  contactName   String          @default("")
  status        PhoneCallStatus @default(EM_ANDAMENTO)
  twilioCallSid String?         @unique
  durationSecs  Int?

  // Vincula ao lead existente no CRM
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  turns PhoneCallTurn[]

  @@index([agentConfigId, createdAt])
}

model PhoneCallTurn {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  callId    String
  call      PhoneCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  role      String   // "user" | "assistant"
  content   String   // transcript ou resposta IA
  audioData String?  @db.Text // base64 do áudio ElevenLabs (assistant turns)

  @@index([callId])
}

// ─── Instagram DM ─────────────────────────────────────────────────────────────

model InstagramConnection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigId String      @unique
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  pageId                     String
  pageAccessToken            String
  instagramBusinessAccountId String   @unique
  instagramUsername          String   @default("")
  tokenExpiresAt             DateTime?
  webhookSubscribed          Boolean  @default(false)
}

// ─── Fluxos condicionais de comentários → DM ─────────────────────────────────

model InstagramCommentFlow {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name         String   // label amigável, ex: "Promoção Verão"
  keywords     String[] @default([]) // vazio = aceita qualquer comentário (catch-all)
  replyMessage String   @default("") // mensagem direta (usado quando funnelId é null)
  order        Int      @default(0)
  active       Boolean  @default(true)

  // Quando definido, dispara o funil em vez de enviar replyMessage
  funnelId String?
  funnel   InstagramFunnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)

  @@index([agentConfigId, order])
}

// ─── Funis de automação estilo Manychat ──────────────────────────────────────

model InstagramFunnel {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  name   String
  active Boolean @default(true)

  // Gatilho por DM direto (independente de comentário)
  dmTriggerEnabled  Boolean  @default(false)
  dmTriggerKeywords String[] @default([]) // vazio = qualquer DM; preenchido = só se o texto contiver a palavra

  blocks     InstagramFunnelBlock[]
  executions InstagramFunnelExecution[]
  triggers   InstagramCommentFlow[]

  @@index([agentConfigId])
}

model InstagramFunnelBlock {
  id       String          @id @default(cuid())
  funnelId String
  funnel   InstagramFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  type  FunnelBlockType
  order Int             @default(0)

  // MESSAGE: content = texto enviado no DM
  // DELAY:   delayMinutes = tempo de espera
  // CONDITION: content = texto da pergunta; branches = JSON [{keywords:string[], label:string, funnelId:string|null}]
  content      String?
  delayMinutes Int?
  branches     Json?   // [{keywords: string[], label: string, funnelId: string | null}]

  @@index([funnelId, order])
}

enum FunnelBlockType {
  MESSAGE    // envia DM e avança imediatamente
  DELAY      // aguarda X minutos antes do próximo bloco
  CONDITION  // envia pergunta, aguarda resposta e ramifica por palavra-chave
}

model InstagramFunnelExecution {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  funnelId      String
  funnel        InstagramFunnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  agentConfigId String
  contactIgsid  String           // IGSID do contato no Instagram
  igBusinessAccountId String
  pageAccessToken     String     // token da conexão no momento da execução
  blockIndex    Int              @default(0)
  status        FunnelExecStatus @default(RUNNING)
  resumeAt      DateTime?        // preenchido quando WAITING_DELAY

  @@index([agentConfigId, contactIgsid, status])
  @@index([status, resumeAt])
}

enum FunnelExecStatus {
  RUNNING
  WAITING_DELAY
  WAITING_INPUT
  COMPLETED
}

// Estado anti-CSRF para o fluxo OAuth do Instagram — expira em 5 minutos
model OAuthState {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  state         String   @unique
  agentConfigId String
  userId        String
  expiresAt     DateTime
  used          Boolean  @default(false)
}

// ===================================
// BRANDING DA PLATAFORMA (Super Admin)
// ===================================

// Singleton — sempre uma única linha com id fixo "singleton" (nunca cuid()). Upsert
// sempre usa where: { id: "singleton" }. Logo do menu do CRM (sem redimensionar) +
// os 3 variants do ícone do PWA (gerados via sharp a partir de 1 upload — ver lib/branding.ts).
model PlatformSettings {
  id             String   @id @default("singleton")
  updatedAt      DateTime @updatedAt
  updatedByEmail String? // só pra exibir "atualizado por X" no admin, sem FK

  // Logo do menu lateral do CRM (CrmSidebar) — exibido em 28x28, sem processamento server-side
  menuLogoBase64   String? @db.Text
  menuLogoMimeType String?

  // Ícone do PWA (app/manifest.ts) — os 3 variants são gerados a partir de UM upload via sharp
  pwaIcon192Base64           String? @db.Text
  pwaIcon192MimeType         String?
  pwaIcon512Base64           String? @db.Text
  pwaIcon512MimeType         String?
  pwaIcon512MaskableBase64   String? @db.Text
  pwaIcon512MaskableMimeType String?

  // Horários fixos (HH:mm, seg-sex) oferecidos na aba Recursos > Agendar uma demonstração
  // (app/(app)/crm/hub/AgendarDemoModal.tsx) — configurável em /admin/demonstracoes.
  demoAvailableTimes String[] @default(["09:00", "11:00", "14:00", "16:00"])
}
